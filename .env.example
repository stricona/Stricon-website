# Base URL for metadata, canonical links, and origin verification
NEXT_PUBLIC_SITE_URL=https://www.stricon.in

# Enquiry delivery configuration
# Comma-separated list: log, resend, webhook (default: log)
ENQUIRY_DELIVERY=log
ENQUIRY_TO=info@stricon.in
ENQUIRY_FROM="STRICON Website <onboarding@resend.dev>"
RESEND_API_KEY=
ENQUIRY_WEBHOOK_URL=
ENQUIRY_WEBHOOK_SECRET=

# Careers delivery configuration
CAREERS_TO=info@stricon.in
CAREERS_RESUME_UPLOAD=off

# Search Engine Indexing Guard (set to 'true' only in production deployment)
ALLOW_INDEXING=false
